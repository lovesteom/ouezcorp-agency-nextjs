// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id                 String   @id @default(cuid())
  email              String   @unique
  password           String
  twoFactorEnabled   Boolean  @default(true)
  twoFactorSecret    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Page {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  content        String?  @db.Text
  images         String?  @db.Text
  links          String?  @db.Text
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([slug])
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  type      String   @default("TEXT")
  group     String   @default("GLOBAL")
  label     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Articles de blog
model Post {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  excerpt        String?  @db.Text
  content        String?  @db.Text
  featuredImage  String?
  author         String?  @default("OuezCorp Team")
  categories     String?  @db.Text // JSON: ["Next.js","SEO"]
  status         String   @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  publishedAt    DateTime @default(now())
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([slug])
}

// Services proposés
model Service {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  excerpt        String?  @db.Text
  content        String?  @db.Text
  featuredImage  String?
  tags           String?  @db.Text // JSON: ["Next.js","TypeScript"]
  order          Int      @default(0)
  status         String   @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, order])
  @@index([slug])
}

// Réalisations / portfolio
model Realisation {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  excerpt        String?  @db.Text
  content        String?  @db.Text
  featuredImage  String?
  client         String?
  stack          String?
  result         String?
  gallery        String?  @db.Text // JSON: ["url1","url2"]
  tags           String?  @db.Text
  order          Int      @default(0)
  status         String   @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, order])
  @@index([slug])
}

// Leads formulaire de contact
model ContactLead {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  budget    String?
  message   String   @db.Text
  status    String   @default("NEW") // NEW, READ, ARCHIVED
  ipAddress String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}
